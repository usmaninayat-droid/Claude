{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.com/schemas/v5-composer/SettingsModuleConfig.schema.json",
  "title": "SettingsModuleConfig",
  "description": "Declarative settings module config. Renders the 3-column settings chrome. Every screen / section / field carries a stable `id`.",
  "type": "object",
  "required": ["kind", "tree", "screens"],
  "properties": {
    "kind": { "const": "settings" },
    "displayName": { "type": "string" },
    "searchPlaceholder": { "type": "string" },
    "tree": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["screens"],
            "properties": {
              "label": { "type": "string" },
              "screens": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "screens": {
      "type": "object",
      "description": "Keyed by screen id (matches tree.sections[i].screens entries).",
      "additionalProperties": { "$ref": "#/$defs/Screen" }
    },
    "rbac": { "$ref": "EntityModuleConfig.schema.json#/$defs/Rbac" }
  },
  "$defs": {
    "Screen": {
      "type": "object",
      "required": ["id", "label", "sections"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "pageTitle": { "type": "string" },
        "pageSubtitle": { "type": "string" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } }
      }
    },
    "Section": {
      "type": "object",
      "required": ["id", "title", "fields"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "icon": { "type": "string" },
        "columns": { "type": "number", "enum": [1, 2, 3], "default": 2 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } }
      }
    },
    "Field": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["text", "number", "select", "multi-select", "currency", "date", "time", "toggle", "textarea"]
        },
        "placeholder": { "type": "string" },
        "icon": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "unit": { "type": "string" },
        "required": { "type": "boolean" },
        "helperText": { "type": "string" }
      }
    }
  }
}

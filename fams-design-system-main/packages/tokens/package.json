{
  "name": "@fams/tokens",
  "version": "0.9.1",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./utilities.css": "./dist/utilities.css",
    "./tenants.css": "./dist/tenants.css",
    "./theme.echarts.json": "./dist/theme.echarts.json",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./animations.css": "./animations.css",
    "./scrollbars.css": "./scrollbars.css"
  },
  "files": [
    "dist",
    "fonts.css",
    "fonts",
    "animations.css",
    "scrollbars.css"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/guard-publish.mjs",
    "build": "style-dictionary build --config style-dictionary.config.js && node ../../scripts/build-css.mjs",
    "test": "vitest run",
    "lint": "node scripts/check-contrast.mjs",
    "typecheck": "echo 'no typecheck for tokens'"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "style-dictionary": "^5",
    "vitest": "catalog:"
  }
}

# Copy to `.env` in this directory before `docker compose up` (never commit
# the real `.env` — it's gitignored). All values have safe local-dev
# defaults baked into docker-compose.yml; override only what you need to
# change (e.g. ports already in use on your machine).

## Image versions — pinned to a known-matched release trio. Bump all three
## together (check hub.docker.com/r/visualregressiontracker/{ui,api,migration}
## for a newer matched set — the upstream repo's own committed .env is the
## source of truth for "which versions go together").
VRT_UI_VERSION=5.1.2
VRT_API_VERSION=5.1.1
VRT_MIGRATION_VERSION=5.1.0

## Ports (host side)
VRT_UI_PORT=8080
VRT_API_PORT=4200
VRT_POSTGRES_PORT=5432

## Frontend <-> backend URLs (must agree with the ports above)
VRT_API_URL=http://localhost:4200
VRT_UI_URL=http://localhost:8080

## Backend
VRT_JWT_SECRET=changeme-local-only
VRT_JWT_LIFE_TIME=1d
VRT_BODY_PARSER_JSON_LIMIT=5mb

## Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt_db

## ── Values you'll need in the CONSUMING repos (showcase / app), NOT
## here — export these where you run `pnpm test:visual` / `pnpm --filter app
## e2e --project=visual-matrix`:
##   VRT_URL=http://localhost:4200          # = VRT_API_URL above
##   VRT_APIKEY=<per-project API key — UI → Project → General → apiKey>
##   VRT_PROJECT=fams-showcase        # (or fams-v5-demo-environment)
##   VRT_BRANCHNAME=<your branch>

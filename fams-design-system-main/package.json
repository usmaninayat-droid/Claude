{
  "name": "fams-design-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "FAMS platform-wide design system — framework-agnostic tokens + React component library.",
  "scripts": {
    "build": "turbo run build",
    "build:registry": "node scripts/build-registry.mjs && node scripts/build-llms.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:tokens && node scripts/test-registry.mjs --check && node scripts/build-llms.mjs --check && node scripts/check-peer-singletons.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node scripts/test-registry.mjs",
    "test:axe": "turbo run test:axe",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:audit": "node scripts/release.mjs --audit-only",
    "smoke:pack": "node scripts/pack-smoke-test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "4.3.3",
    "turbo": "^2",
    "typescript": "catalog:",
    "vite": "^6.4.3"
  }
}

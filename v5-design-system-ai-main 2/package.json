{
  "name": "@fams/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FAMS Design System — a standalone React + TypeScript + Tailwind 4 component library. Tokens are Figma-aligned (Design System V2); the component breadth is ported from the FAMS V5 kit. Ships with a live showcase / docs app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shoot": "node scripts/team/parity/shoot.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens/theme.css": "./src/tokens/theme.css",
    "./tokens/fonts.css": "./src/tokens/fonts.css",
    "./tailwind.preset": "./src/tokens/tailwind.preset.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "0.487.0",
    "maplibre-gl": "^4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "sonner": "1.7.1",
    "tailwind-merge": "2.6.0",
    "tw-animate-css": "^1.2.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.3",
    "@tailwindcss/vite": "4.1.12",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "puppeteer-core": "^25.3.0",
    "storybook": "^10.4.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.5.4",
    "vite": "6.3.5",
    "vitest": "^4.1.8"
  }
}

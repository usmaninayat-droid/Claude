      {
        "id": "sts_pm_ongoing",
        "key": "ongoing",
        "label": "Ongoing",
        "color": "#1b6df5"
      },
      {
        "id": "sts_pm_overdue",
        "key": "overdue",
        "label": "Overdue",
        "color": "#e51f11"
      },
      {
        "id": "sts_pm_completed",
        "key": "completed",
        "label": "Completed",
        "color": "#0d864e"
      }
    ],

{
  "$schema": "../../../../node_modules/@fams/v5-composer/schemas/EntityModuleConfig.schema.json",
  "kind": "entity",
  "code": "crm/contact-person",
  "name": "Contact Person",
  "uidPrefix": "CP",
  "systemcolumns": [
    { "id": "fld_cp_name", "col": "title", "name": "Full Name", "type": "SmallText", "required": true },
    { "id": "fld_cp_company", "col": "systemcol1", "name": "Company", "type": "SingleReference", "refModule": "Entity", "entityType": "crm/company" },
    { "id": "fld_cp_job_title", "col": "systemcol2", "name": "Job Title", "type": "SmallText" },
    { "id": "fld_cp_email", "col": "systemcol3", "name": "Email", "type": "Email" },
    { "id": "fld_cp_phone", "col": "systemcol4", "name": "Phone", "type": "Phone" },
    { "id": "fld_cp_status", "col": "status", "name": "Status", "type": "SingleSelect", "listValues": ["Active", "Inactive"] },
    { "id": "fld_cp_tags", "col": "tags", "name": "Tags", "type": "tags" }
  ],
  "uiConfig": {
    "icon": "user",
    "statusList": [
      { "id": "sts_cp_active", "key": "Active", "label": "Active", "color": "#16a34a" },
      { "id": "sts_cp_inactive", "key": "Inactive", "label": "Inactive", "color": "#94a3b8" }
    ],
    "profile": {
      "title": { "id": "fld_cp_name", "col": "title", "pos": "left" },
      "details": [
        { "id": "fld_cp_company", "col": "systemcol1", "pos": "left", "order": 1, "component": { "name": "LinkView" } },
        { "id": "fld_cp_status", "col": "status", "pos": "right", "order": 1, "component": { "name": "StatusList" } },
        { "id": "fld_cp_job_title", "col": "systemcol2", "pos": "left", "order": 2 },
        { "id": "fld_cp_email", "col": "systemcol3", "pos": "right", "order": 2 },
        { "id": "fld_cp_phone", "col": "systemcol4", "pos": "left", "order": 3 }
      ],
      "sections": [
        {
          "id": "sec_cp_details",
          "name": "Contact Details",
          "order": 1,
          "fields": [
            { "id": "fld_cp_company", "col": "systemcol1", "order": 1, "component": { "name": "LinkView" } },
            { "id": "fld_cp_job_title", "col": "systemcol2", "order": 2 },
            { "id": "fld_cp_email", "col": "systemcol3", "order": 3 },
            { "id": "fld_cp_phone", "col": "systemcol4", "order": 4 }
          ]
        }
      ],
      "rightPanel": {
        "type": "tab",
        "tabs": [
          { "id": "tab_cp_overview", "key": "overview", "title": "Overview", "order": 1, "component": { "name": "OverviewSummary" } },
          { "id": "tab_cp_details", "key": "details", "title": "Details", "order": 2, "component": { "name": "sections" } },
          { "id": "tab_cp_linked", "key": "linked", "title": "Linked", "order": 3, "component": { "name": "LinkedRecords" } }
        ]
      }
    },
    "filters": [
      { "id": "flt_cp_status", "col": "status", "order": 1 },
      { "id": "flt_cp_company", "col": "systemcol1", "order": 2 }
    ],
    "search": { "columns": ["title", "systemcol3"] },
    "rowActions": { "delete": true, "archive": true, "requiredPrivilege": "contact-person.view" },
    "bulkActions": { "delete": true, "export": true },
    "listSelectable": true,
    "recordNoun": { "one": "contact", "many": "contacts" },
    "creation": { "layout": "flat", "fieldChrome": "inset-label", "label": "Create New Contact Person" }
  },
  "listcolumns": [
    { "id": "fld_uniqueidentifier", "col": "uniqueidentifier", "name": "Contact ID", "component": { "name": "TextView" } },
    { "id": "fld_cp_name", "col": "title", "component": { "name": "TextView", "props": { "handleOverflow": true } } },
    { "id": "fld_cp_company", "col": "systemcol1", "component": { "name": "LinkView" } },
    { "id": "fld_cp_job_title", "col": "systemcol2", "component": { "name": "TextView" } },
    { "id": "fld_cp_email", "col": "systemcol3", "component": { "name": "TextView" } },
    { "id": "fld_cp_status", "col": "status", "component": { "name": "StatusList" } },
    { "id": "fld_cp_tags", "col": "tags", "component": { "name": "TagList" } }
  ]
}

        { "id": "fld_pm_blackspot", "col": "systemcol2", "pos": "left", "order": 1, "component": { "name": "IconTextView", "props": { "icon": "marker-pin-02" } } },
        { "id": "fld_pm_status", "col": "status", "pos": "right", "order": 1, "component": { "name": "StatusList" } },

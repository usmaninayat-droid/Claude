{
  "$schema": "../../../../node_modules/@fams/v5-composer/schemas/EntityModuleConfig.schema.json",
  "kind": "entity",
  "code": "plan-monitoring/daily-plan",
  "name": "Plan Monitoring",
  "uidPrefix": "FPL",
  "views": ["list", "hybrid"],
  "systemcolumns": [
    { "id": "fld_pm_uniqueidentifier", "col": "uniqueidentifier", "name": "Daily Plan ID", "type": "Auto" },
    { "id": "fld_pm_title", "col": "title", "name": "Daily Plan Title", "type": "SmallText", "required": true },
    { "id": "fld_pm_sourceplan", "col": "systemcol1", "name": "Source Plan", "type": "SingleReference", "refModule": "Entity", "entityType": "smart-planning/plan", "component": { "name": "LinkView" } },
    { "id": "fld_pm_blackspot", "col": "systemcol2", "name": "Black Spot Zone", "type": "SingleSelect", "listValues": ["Al Wakrah Tunnel 3", "Al Wakrah Underpass 1", "Hamad Hospital Access Route", "Doha Corniche Underpass", "Al Sadd Tunnel", "Al Rayyan Underpass 2", "Al Rayyan West Tunnel", "Umm Salal Hospital Access Route", "Umm Salal Underpass 4", "Al Daayen Tunnel 2", "Al Khaleej", "Al Khor Corniche", "Al Khor Industrial Area", "Al Rayyan", "Al Thumama", "Al Wakrah Corniche South", "Al Wukair", "Al Wukair Depot", "Doha Corniche", "Doha Port", "Education City", "Lusail Boulevard", "Lusail Marina North", "Mesaieed", "Mesaieed Hospital Road", "Ras Laffan", "Simaisma", "Umm Salal", "Umm Salal Mohammed", "West Bay"], "required": true, "component": { "name": "IconTextView", "props": { "icon": "marker-pin-02" } } },
    { "id": "fld_pm_zone", "col": "systemcol3", "name": "Zone", "type": "SingleSelect", "listValues": ["Doha", "Al Rayyan", "Al Wakrah", "Umm Salal", "Al Daayen"], "required": true },
    { "id": "fld_pm_tanker", "col": "systemcol4", "name": "Tanker", "type": "SmallText", "required": true, "component": { "name": "IconTextView", "props": { "icon": "truck" } } },
    { "id": "fld_pm_driver", "col": "systemcol5", "name": "Driver", "type": "SmallText", "component": { "name": "PersonView", "props": { "tone": "info" } } },
    { "id": "fld_pm_inspector", "col": "systemcol6", "name": "Inspector", "type": "SmallText", "component": { "name": "PersonView" } },
    { "id": "fld_pm_shift", "col": "systemcol7", "name": "Shift", "type": "SingleSelect", "listValues": ["Morning", "Afternoon", "Night"], "default": "Morning", "component": { "name": "IconTextView", "props": { "icon": "clock" } } },
    { "id": "fld_pm_plannedstart", "col": "systemcol8", "name": "Planned Start", "type": "SmallText" },
    { "id": "fld_pm_plannedend", "col": "systemcol9", "name": "Planned End", "type": "SmallText" },
    { "id": "fld_pm_status", "col": "status", "name": "Status", "type": "SingleSelect", "listValues": ["Scheduled", "Executing", "Completed"], "default": "Scheduled", "component": { "name": "IconSelect", "props": { "icon": "flag", "optionTone": { "Scheduled": "warning", "Executing": "info", "Completed": "success" } } } },
    { "id": "fld_pm_progressdone", "col": "systemcol10", "name": "Stops Completed", "type": "Numeric" },
    { "id": "fld_pm_progresstotal", "col": "systemcol11", "name": "Total Stops", "type": "Numeric" },
    { "id": "fld_pm_compliance", "col": "systemcol12", "name": "Compliance %", "type": "Numeric", "unit": "%" },
    { "id": "fld_pm_watercollected", "col": "systemcol13", "name": "Water Collected", "type": "Numeric", "unit": "L" },
    { "id": "fld_pm_lat", "col": "lat", "name": "Latitude", "type": "Numeric", "group": "Location" },
    { "id": "fld_pm_lng", "col": "lng", "name": "Longitude", "type": "Numeric", "group": "Location" },
    { "id": "fld_pm_sourcerequest", "col": "source_request", "name": "Source Request", "type": "SingleReference", "refModule": "Entity", "entityType": "incidents/incident", "component": { "name": "LinkView" } },

      "latCol": "lat",
      "lngCol": "lng",
      "zoneCol": "systemcol3",
      "zones": [
        { "id": "Doha", "label": "Doha", "color": "#0072D6", "points": [[51.49, 25.31], [51.50, 25.36], [51.55, 25.38], [51.58, 25.35], [51.56, 25.29], [51.50, 25.27]] },
        { "id": "Al Rayyan", "label": "Al Rayyan", "color": "#12B76A", "points": [[51.38, 25.18], [51.40, 25.26], [51.49, 25.27], [51.50, 25.20], [51.44, 25.16]] },
        { "id": "Al Wakrah", "label": "Al Wakrah", "color": "#F79009", "points": [[51.60, 25.22], [51.62, 25.28], [51.69, 25.29], [51.70, 25.24], [51.64, 25.20]] },
        { "id": "Umm Salal", "label": "Umm Salal", "color": "#6941C6", "points": [[51.57, 25.33], [51.58, 25.39], [51.64, 25.40], [51.65, 25.34], [51.60, 25.31]] },
        { "id": "Al Daayen", "label": "Al Daayen", "color": "#667085", "points": [[51.48, 25.46], [51.49, 25.54], [51.57, 25.55], [51.58, 25.48], [51.52, 25.44]] }
      ],
      "records": {
        "colorBy": {
          "col": "status",
          "legendTitle": "Execution Status",
          "values": [
            { "value": "Scheduled", "label": "Scheduled", "color": "#FDB022" },
            { "value": "Executing", "label": "Executing", "color": "#0072D6" },
            { "value": "Completed", "label": "Completed", "color": "#12B76A" }
          ],
          "fallbackColor": "#98A2B3"
        },
        "radius": 8
      }
    },
    "listSummary": [
      { "id": "sum_pm_total", "label": "Total Daily Plans" },
      { "id": "sum_pm_executing", "label": "Executing", "icon": "loading", "iconColor": "#0072D6", "iconBg": "#EFF8FF", "filter": { "col": "status", "equals": "Executing" } },
      { "id": "sum_pm_scheduled", "label": "Scheduled", "icon": "hourglass-03", "iconColor": "#DC6803", "iconBg": "#FFFAEB", "filter": { "col": "status", "equals": "Scheduled" } },
      { "id": "sum_pm_completed", "label": "Completed", "icon": "check-circle", "iconColor": "#12B76A", "iconBg": "#ECFDF3", "filter": { "col": "status", "equals": "Completed" } }
    ]
  },
  "listcolumns": [
    { "id": "fld_pm_uniqueidentifier", "col": "uniqueidentifier", "name": "ID", "component": { "name": "TextView" } },
    { "id": "fld_pm_title", "col": "title", "component": { "name": "TextView", "props": { "handleOverflow": true } } },
    { "id": "fld_pm_sourceplan", "col": "systemcol1", "name": "Source Plan", "component": { "name": "LinkView" } },
    { "id": "fld_pm_sourcerequest", "col": "source_request", "name": "Source Request", "component": { "name": "LinkView" } },
    { "id": "fld_pm_tanker", "col": "systemcol4", "component": { "name": "TextView" } },
    { "id": "fld_pm_driver", "col": "systemcol5", "component": { "name": "PersonView", "props": { "tone": "info" } } },
    { "id": "fld_pm_shift", "col": "systemcol7", "component": { "name": "TextView" } },
    { "id": "fld_pm_plannedstart", "col": "systemcol8", "name": "Planned Start", "component": { "name": "TextView" } },
    { "id": "fld_pm_plannedend", "col": "systemcol9", "name": "Planned End", "component": { "name": "TextView" } },
    { "id": "fld_pm_status", "col": "status", "component": { "name": "StatusList" } },
    { "id": "fld_pm_progressdone", "col": "systemcol10", "name": "Stops Done", "component": { "name": "TextView" } },
    { "id": "fld_pm_progresstotal", "col": "systemcol11", "name": "Stops Total", "component": { "name": "TextView" } },
    { "id": "fld_pm_compliance", "col": "systemcol12", "name": "Compliance %", "component": { "name": "TextView" } }
  ]

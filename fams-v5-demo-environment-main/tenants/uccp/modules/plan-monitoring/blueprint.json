        { "id": "fld_pm_sourcerequest", "col": "source_request", "pos": "right", "order": 3, "component": { "name": "LinkView" } }
      ],
      "sections": [
        {
          "id": "sec_pm_execution",
          "name": "Execution",
          "order": 1,
          "fields": [
            { "id": "fld_pm_tanker", "col": "systemcol4", "order": 1, "component": { "name": "IconTextView", "props": { "icon": "truck" } } },
            { "id": "fld_pm_driver", "col": "systemcol5", "order": 2, "component": { "name": "PersonView", "props": { "tone": "info" } } },
            { "id": "fld_pm_inspector", "col": "systemcol6", "order": 3, "component": { "name": "PersonView" } },
            { "id": "fld_pm_shift", "col": "systemcol7", "order": 4, "component": { "name": "IconTextView", "props": { "icon": "clock" } } },
            { "id": "fld_pm_plannedstart", "col": "systemcol8", "order": 5 },
            { "id": "fld_pm_plannedend", "col": "systemcol9", "order": 6 }
          ]
        },
        {
          "id": "sec_pm_progress",
          "name": "Progress",
          "order": 2,
          "fields": [
            { "id": "fld_pm_progressdone", "col": "systemcol10", "order": 1 },
            { "id": "fld_pm_progresstotal", "col": "systemcol11", "order": 2 },
            { "id": "fld_pm_compliance", "col": "systemcol12", "order": 3 },
            { "id": "fld_pm_watercollected", "col": "systemcol13", "order": 4 }
          ]
        }
      ],
      "rightPanel": {
        "type": "tab",
        "tabs": [
          { "id": "tab_pm_details", "key": "details", "title": "Details", "order": 1, "component": { "name": "sections" } }

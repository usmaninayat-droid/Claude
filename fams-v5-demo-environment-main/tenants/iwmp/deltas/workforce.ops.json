{
  "$schema": "../../../tools/schemas/OpsFile.schema.json",
  "module": "workforce",
  "ops": [
    {
      "op": "addTab",
      "opId": "op_iwmp_workforce_trainings_tab",
      "after": "tab_wf_tablet_activity",
      "tab": {
        "id": "tab_wf_trainings",
        "key": "trainings",
        "title": "Training",
        "order": 3,
        "component": {
          "name": "ComplianceTable",
          "props": {
            "field": "trainings",
            "statusKey": "status",
            "codeKey": "trainingCode",
            "roleField": "systemcol1",
            "sectionLabel": "Required for Role – {role}",
            "scoreLabel": "Compliance Score",
            "summaryTitle": "Compliance Summary",
            "headerEdit": true,
            "emptyText": "No trainings recorded for this workforce member.",
            "buckets": {
              "valid": [
                "Valid"
              ],
              "expiring": [
                "Expiring"
              ],
              "expired": [
                "Expired"
              ],
              "blocked": [
                "Blocked"
              ]
            },
            "bucketLabels": {
              "valid": "Valid",
              "expiring": "Expiring",
              "expired": "Expired",
              "blocked": "Blocked"
            },
            "criticalBuckets": [
              "expired",
              "blocked"
            ],
            "alert": {
              "message": "{count} safety-critical certificate{s} {are} expired or missing. Roster hides this {role} from assignment until {codes} {are} renewed.",
              "ctaLabel": "Renew",
              "ctaToast": "Renewal requested for {codes}."
            },
            "statusColors": {
              "Valid": "#12b76a",
              "Expiring": "#f79009",
              "Expired": "#d92d20",
              "Blocked": "#f04438"
            },
            "statusLabels": {
              "Valid": "Valid",
              "Expiring": "Expiring",
              "Expired": "Expired",
              "Blocked": "Blocks Dispatch"
            },
            "columns": [
              {
                "key": "trainingName",
                "label": "TRAINING NAME",
                "type": "text"
              },
              {
                "key": "trainingCode",
                "label": "ID",
                "type": "text"
              },
              {
                "key": "vehicleCategory",
                "label": "CLASSIFICATION",
                "type": "text"
              },
              {
                "key": "completedOn",
                "label": "COMPLETED",
                "type": "text"
              },
              {
                "key": "expiresOn",
                "label": "EXPIRES",
                "type": "text"
              },
              {
                "key": "status",
                "label": "STATUS",
                "type": "statusPill"
              }
            ],
            "rowActions": [
              {
                "label": "Renew certificate",
                "toast": "Renewal requested for {code}."
              },
              {
                "label": "View certificate",
                "toast": "Opening certificate {code}…"
              }
            ]
          }
        }
      }
    },
    {
      "op": "addTab",
      "opId": "op_iwmp_workforce_attendance_tab",
      "after": "tab_wf_trainings",
      "tab": {
        "id": "tab_wf_attendance",
        "key": "attendance_log",
        "title": "Attendance Log",
        "order": 4,
        "component": {
          "name": "OverviewWidgets",
          "props": {
            "widgets": [
              {
                "type": "filterBar",
                "filters": [
                  {
                    "kind": "dateRange",
                    "icon": "calendar",
                    "label": "Date Range",
                    "value": "Last 30 Days"
                  },
                  {
                    "kind": "select",
                    "icon": "filter-lines",
                    "label": "Source",
                    "value": "All"
                  }
                ]
              },
              {
                "type": "barChart",
                "title": "Working Hours",
                "icon": "bar-chart-01",
                "seriesField": "workingHours",
                "yAxisTitle": "Hours",
                "color": "#93C5FD"
              },
              {
                "type": "recordTable",
                "field": "attendanceLog",
                "columns": [
                  {
                    "key": "date",
                    "label": "DATE",
                    "type": "text"
                  },
                  {
                    "key": "clockIn",
                    "label": "CLOCK IN",
                    "type": "text"
                  },
                  {
                    "key": "clockOut",
                    "label": "CLOCK-OUT",
                    "type": "text"
                  },
                  {
                    "key": "clockInLocation",
                    "label": "CLOCK-IN LOCATION",
                    "type": "text"
                  },
                  {
                    "key": "clockOutLocation",
                    "label": "CLOCK-OUT LOCATION",
                    "type": "text"
                  },
                  {
                    "key": "duration",
                    "label": "DURATION",
                    "type": "text"
                  },
                  {
                    "key": "source",
                    "label": "SOURCE",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}

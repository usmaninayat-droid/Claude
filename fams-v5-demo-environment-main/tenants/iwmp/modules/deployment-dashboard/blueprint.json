{
  "$schema": "../../../../tools/schemas/DashboardModuleConfig.schema.json",
  "id": "deployment-dashboard",
  "kind": "dashboard",
  "icon": "gauge",
  "displayName": {
    "singular": "Deployment Dashboard",
    "plural": "Deployment Dashboard"
  },
  "description": "Manpower deployment insight — headcount, duty mix, deployment against requirement and the daily deployment sheet (RST-DSH).",
  "filterPills": [
    {
      "id": "pill-timeframe",
      "label": "Date",
      "type": "time-range",
      "dimension": "timeframe",
      "defaultValue": "today",
      "options": [
        {
          "value": "today",
          "label": "Today"
        },
        {
          "value": "last-7-days",
          "label": "Last 7 days"
        },
        {
          "value": "last-30-days",
          "label": "Last 30 days"
        }
      ]
    },
    {
      "id": "pill-project",
      "label": "Project",
      "type": "single-select",
      "dimension": "project",
      "options": [
        {
          "value": "msw",
          "label": "MSW"
        },
        {
          "value": "commercial",
          "label": "Commercial"
        }
      ]
    },
    {
      "id": "pill-shift",
      "label": "Shift",
      "type": "single-select",
      "dimension": "shift",
      "options": [
        {
          "value": "day",
          "label": "Day"
        },
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "afn",
          "label": "Afternoon"
        },
        {
          "value": "evening",
          "label": "Evening"
        },
        {
          "value": "mid",
          "label": "Mid"
        }
      ]
    }
  ],
  "widgetGrid": [
    {
      "id": "w-headcount-breakdown",
      "title": "Headcount breakdown — Monday 31 August",
      "type": "breakdown-strip",
      "span": 12,
      "dataSource": {
        "icon": "users",
        "subtitle": "reported HC from attendance machine",
        "scopeFilter": {
          "id": "headcount-scope",
          "label": "Headcount",
          "allLabel": "All Employees",
          "options": [
            {
              "value": "drivers",
              "label": "Drivers"
            },
            {
              "value": "helpers",
              "label": "Helpers"
            },
            {
              "value": "supervisors",
              "label": "Supervisors"
            }
          ]
        },
        "slices": [
          {
            "id": "total",
            "label": "Total Head Count",
            "value": 764,
            "tone": "primary"
          },
          {
            "id": "planned",
            "label": "Planned Head Count",
            "value": 470,
            "tone": "info"
          },
          {
            "id": "reported",
            "label": "Reported Head Count",
            "value": 459,
            "tone": "success"
          },
          {
            "id": "absent",
            "label": "Absenteeism",
            "value": 35,
            "tone": "danger"
          },
          {
            "id": "weekly-off",
            "label": "Weekly Off",
            "value": 105,
            "tone": "neutral"
          },
          {
            "id": "vacation",
            "label": "Vacation",
            "value": 42,
            "tone": "yellow"
          },
          {
            "id": "available",
            "label": "Available Head Count",
            "value": 158,
            "tone": "lavender"
          }
        ],
        "ariaLabel": "Headcount breakdown for Monday 31 August: total, planned, reported, absenteeism, weekly off, vacation and available head counts reported from the attendance machine."
      }
    },
    {
      "id": "w-deployment-compliance",
      "title": "Deployment Compliance",
      "type": "compliance-gauge",
      "span": 4,
      "dataSource": {
        "subtitle": "Reported head count vs planned",
        "value": 95,
        "min": 0,
        "max": 100,
        "centerLabel": {
          "value": "95%",
          "caption": "Reported vs Planned"
        },
        "ariaLabel": "Deployment compliance — reported head count as a percentage of planned head count for the selected date."
      }
    },
    {
      "id": "w-duty-mix",
      "title": "Duty Mix (Today)",
      "type": "donut",
      "span": 4,
      "dataSource": {
        "legendOrientation": "vertical",
        "centerLabel": {
          "value": "671",
          "caption": "Duties"
        },
        "slices": [
          {
            "label": "Route (RT)",
            "value": 486,
            "colorIndex": 1
          },
          {
            "label": "Reliever (RL)",
            "value": 29,
            "colorIndex": 2
          },
          {
            "label": "Weekly Off (WO)",
            "value": 74,
            "colorIndex": 3
          },
          {
            "label": "Annual Vacation (AV)",
            "value": 22,
            "colorIndex": 4
          },
          {
            "label": "Emergency Leave (EL)",
            "value": 10,
            "colorIndex": 5
          },
          {
            "label": "On Call (OC)",
            "value": 18,
            "colorIndex": 1
          },
          {
            "label": "Standby / OJT (SB)",
            "value": 12,
            "colorIndex": 2
          },
          {
            "label": "Extra Assignment (EX)",
            "value": 20,
            "colorIndex": 3
          }
        ],
        "ariaLabel": "Duty mix for today across route, reliever, weekly off, vacation, emergency leave, on-call, standby and extra assignment duties."
      }
    },
    {
      "id": "w-by-project",
      "title": "Deployment by Project",
      "type": "donut",
      "span": 4,
      "dataSource": {
        "subtitle": "Reported head count by project",
        "legendOrientation": "vertical",
        "centerLabel": {
          "value": "486",
          "caption": "Deployed"
        },
        "slices": [
          {
            "id": "msw",
            "label": "MSW",
            "value": 383,
            "colorIndex": 1,
            "dimensions": {
              "project": "msw"
            }
          },
          {
            "id": "commercial",
            "label": "Commercial",
            "value": 103,
            "colorIndex": 2,
            "dimensions": {
              "project": "commercial"
            }
          }
        ],
        "ariaLabel": "Deployment by project — reported head count split between the MSW and Commercial projects."
      }
    },
    {

{
  "$schema": "../../../../tools/schemas/DashboardModuleConfig.schema.json",
  "id": "deployment-dashboard",
  "kind": "dashboard",
  "icon": "gauge",
  "displayName": {
    "singular": "Deployment Dashboard",
    "plural": "Deployment Dashboard"
  },
  "description": "Manpower deployment insight \u2014 headcount, duty mix, deployment against requirement and the daily deployment sheet (RST-DSH).",
  "filterPills": [
    {
      "id": "pill-timeframe",
      "label": "Date",
      "type": "time-range",
      "dimension": "timeframe",
      "defaultValue": "today",
      "options": [
        {
          "value": "today",
          "label": "Today"
        },
        {
          "value": "last-7-days",
          "label": "Last 7 days"
        },
        {
          "value": "last-30-days",
          "label": "Last 30 days"
        }
      ]
    },
    {
      "id": "pill-project",
      "label": "Project",
      "type": "single-select",
      "dimension": "project",
      "options": [
        {
          "value": "msw",
          "label": "MSW"
        },
        {
          "value": "commercial",
          "label": "Commercial"
        }
      ]
    },
    {
      "id": "pill-shift",
      "label": "Shift",
      "type": "single-select",
      "dimension": "shift",
      "options": [
        {
          "value": "day",
          "label": "Day"
        },
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "afn",
          "label": "Afternoon"
        },
        {
          "value": "evening",
          "label": "Evening"
        },
        {
          "value": "mid",
          "label": "Mid"
        }
      ]
    }
  ],
  "kpiStrip": [
    {
      "id": "kpi-total-manpower",
      "label": "Total Manpower",
      "icon": "users",
      "type": "stat",
      "format": "integer",
      "tone": "primary",
      "dataSource": {
        "kind": "static",
        "value": 632
      }
    },
    {
      "id": "kpi-drivers",
      "label": "Drivers",
      "icon": "truck",
      "type": "stat",
      "format": "integer",
      "tone": "info",
      "valueSuffix": "HDD 168 \u00b7 LDD 64",
      "dataSource": {
        "kind": "static",
        "value": 232
      }
    },
    {
      "id": "kpi-helpers",
      "label": "Helpers",
      "icon": "user",
      "type": "stat",
      "format": "integer",
      "tone": "info",
      "dataSource": {
        "kind": "static",
        "value": 400
      }
    },
    {
      "id": "kpi-operational",
      "label": "Operational Staff",
      "icon": "briefcase",
      "type": "stat",
      "format": "integer",
      "tone": "primary",
      "dataSource": {
        "kind": "static",
        "value": 618
      }
    },
    {
      "id": "kpi-pending-rostering",
      "label": "Pending Rostering",
      "icon": "calendar",
      "type": "stat",
      "format": "integer",
      "tone": "warning",
      "dataSource": {
        "kind": "static",
        "value": 12,
        "variants": [
          {
            "when": {
              "timeframe": "last-7-days"
            },
            "value": 34
          },
          {
            "when": {
              "timeframe": "last-30-days"
            },
            "value": 61
          }
        ]
      }
    },
    {
      "id": "kpi-training-risk",
      "label": "Training Pending & Expired",
      "icon": "alert-triangle",
      "type": "stat",
      "format": "integer",
      "tone": "danger",
      "valueSuffix": "8 blocked",
      "dataSource": {
        "kind": "static",
        "value": 27
      }
    }
  ],
  "widgetGrid": [
    {
      "id": "w-deployment-compliance",
      "title": "Deployment Compliance",
      "type": "compliance-gauge",
      "span": 4,
      "dataSource": {
        "subtitle": "Reported head count vs planned",
        "value": 95,
        "min": 0,
        "max": 100,
        "centerLabel": {
          "value": "95%",
          "caption": "Reported vs Planned"
        },
        "ariaLabel": "Deployment compliance \u2014 reported head count as a percentage of planned head count for the selected date."
      }
    },
    {
      "id": "w-duty-mix",
      "title": "Duty Mix (Today)",
      "type": "donut",
      "span": 4,
      "dataSource": {
        "legendOrientation": "vertical",
        "centerLabel": {
          "value": "671",
          "caption": "Duties"
        },
        "slices": [
          {
            "label": "Route (RT)",
            "value": 486,
            "colorIndex": 1
          },
          {
            "label": "Reliever (RL)",
            "value": 29,
            "colorIndex": 2
          },
          {
            "label": "Weekly Off (WO)",
            "value": 74,
            "colorIndex": 3
          },
          {
            "label": "Annual Vacation (AV)",
            "value": 22,
            "colorIndex": 4
          },
          {
            "label": "Emergency Leave (EL)",
            "value": 10,
            "colorIndex": 5
          },
          {
            "label": "On Call (OC)",
            "value": 18,
            "colorIndex": 1
          },
          {
            "label": "Standby / OJT (SB)",
            "value": 12,
            "colorIndex": 2
          },
          {
            "label": "Extra Assignment (EX)",
            "value": 20,
            "colorIndex": 3
          }
        ],
        "ariaLabel": "Duty mix for today across route, reliever, weekly off, vacation, emergency leave, on-call, standby and extra assignment duties."
      }
    },
    {
      "id": "w-by-project",
      "title": "Deployment by Project",
      "type": "donut",
      "span": 4,
      "dataSource": {
        "subtitle": "Reported head count by project",
        "legendOrientation": "vertical",
        "centerLabel": {
          "value": "486",
          "caption": "Deployed"
        },
        "slices": [
          {
            "id": "msw",
            "label": "MSW",
            "value": 383,
            "colorIndex": 1,
            "dimensions": {
              "project": "msw"
            }
          },
          {
            "id": "commercial",
            "label": "Commercial",
            "value": 103,
            "colorIndex": 2,
            "dimensions": {
              "project": "commercial"
            }
          }
        ],
        "ariaLabel": "Deployment by project \u2014 reported head count split between the MSW and Commercial projects."
      }
    },
    {
      "id": "w-workforce-readiness",
      "title": "Workforce Readiness",
      "type": "stacked-bar",
      "span": 12,
      "dataSource": {
        "orientation": "horizontal",
        "subtitle": "Operational staff by deployment state (selected date)",
        "categories": [
          "Readiness"
        ],
        "series": [
          {
            "id": "on-duty",
            "label": "On Duty",
            "colorIndex": 1,
            "data": [
              486
            ]
          },
          {
            "id": "late",
            "label": "Late",
            "colorIndex": 3,
            "data": [
              18
            ]
          },
          {
            "id": "standby",
            "label": "Standby",
            "colorIndex": 2,
            "data": [
              24
            ]
          },
          {
            "id": "next-shift",
            "label": "Next Shift",
            "colorIndex": 4,
            "data": [
              58
            ]
          },
          {
            "id": "on-leave",
            "label": "On Leave",
            "colorIndex": 5,
            "data": [
              32
            ]
          }
        ],
        "axis": {
          "x": {
            "title": "Employees",
            "min": 0
          }
        },
        "legendPlacement": "bottom",
        "ariaLabel": "Workforce readiness \u2014 operational staff distributed across on-duty, late, standby, next-shift and on-leave states for the selected date."
      }
    },
    {
      "id": "w-headcount",
      "title": "Headcount Breakdown",
      "type": "bar",
      "span": 6,
      "dataSource": {
        "orientation": "horizontal",
        "subtitle": "Attendance-machine truth for the selected date",
        "categories": [
          "Total",
          "Planned",
          "Reported",
          "Absenteeism",
          "Weekly Off",
          "Vacation",
          "Available"
        ],
        "series": [
          {
            "label": "Head Count",
            "colorToken": "var(--color-primary)",
            "data": [
              618,
              512,
              486,
              26,
              74,
              32,
              26
            ],
            "unit": "staff"
          }
        ],
        "axis": {
          "x": {
            "title": "Employees",
            "min": 0
          }
        },
        "showValues": true,
        "ariaLabel": "Headcount breakdown \u2014 total, planned, reported, absenteeism, weekly off, vacation and available head counts for the selected date."
      }
    },
    {
      "id": "w-daily-trend",

{
  "$schema": "../../../../node_modules/@fams/v5-composer/schemas/EntityModuleConfig.schema.json",
  "kind": "entity",
  "code": "project-management/project",
  "name": "Project Management",
  "uidPrefix": "PMM",
  "views": ["list", "kanban"],
  "systemcolumns": [
    {
      "id": "fld_pmm_name",
      "col": "title",
      "name": "Project Name",
      "type": "SmallText",
      "required": true
    },
    {
      "id": "fld_pmm_type",
      "col": "systemcol1",
      "name": "Project Type",
      "type": "SingleSelect",
      "required": true,
      "listValues": ["Municipal", "Commercial", "One-Off Job"]
    },
    {
      "id": "fld_pmm_client",
      "col": "systemcol2",
      "name": "Client",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_category",
      "col": "systemcol3",
      "name": "Client Category",
      "type": "SingleSelect",
      "listValues": [
        "Cat 1 · Mega Scale (≥ AED 5M)",
        "Cat 2 · Large Scale (AED 3–5M)",
        "Cat 3 · Medium Scale (AED 1–3M)",
        "Cat 4 · Small Scale (AED 250K–1M)",
        "Cat 5 · Micro Scale (< AED 250K)",
        "Cat 6 · One-Off Job"
      ]
    },
    {
      "id": "fld_pmm_contract_ref",
      "col": "systemcol4",
      "name": "Contract Number",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_contract_value",
      "col": "systemcol5",
      "name": "Contract Value (AED)",
      "type": "Number"
    },
    {
      "id": "fld_pmm_start_date",
      "col": "systemcol6",
      "name": "Contract Start",
      "type": "Date"
    },
    {
      "id": "fld_pmm_end_date",
      "col": "systemcol7",
      "name": "Contract End",
      "type": "Date"
    },
    {
      "id": "fld_pmm_lot",
      "col": "systemcol8",
      "name": "LOT",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_zone",
      "col": "systemcol9",
      "name": "Zone",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_district",
      "col": "systemcol10",
      "name": "District",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_service_type",
      "col": "systemcol11",
      "name": "Service Type",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_pm",
      "col": "systemcol12",
      "name": "Project Manager",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_area_mgr",
      "col": "systemcol13",
      "name": "Area Manager",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_supervisor",
      "col": "systemcol14",
      "name": "Supervisor",
      "type": "SmallText"
    },
    {
      "id": "fld_pmm_route_count",
      "col": "systemcol15",
      "name": "Routes",
      "type": "Number",
      "creation": { "hidden": true }

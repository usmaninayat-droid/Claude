{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FAMS v5 demo application — boots the real stack (v5-kit bootstrapTenant + demo-kit store + MSW over the v5 API contract + composer/templates) from committed resolved/ blueprints.",
  "scripts": {
    "dev": "vite --port 6300 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 6300 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "msw:init": "msw init public --save",
    "e2e": "playwright test",
    "test:visual": "playwright test --project=visual-matrix",
    "test:visual:update": "playwright test --project=visual-matrix --update-snapshots"
  },
  "dependencies": {
    "@fams/demo-kit": "link:../../fams-design-system/packages/demo-kit",
    "@fams/skeleton-kit": "link:../../fams-design-system/packages/skeleton-kit",
    "@fams/tokens": "link:../../fams-design-system/packages/tokens",
    "@fams/ui-kit": "link:../../fams-design-system/packages/ui-kit",
    "@fams/v5-composer": "link:../../fams-design-system/packages/v5-composer",
    "@fams/v5-kit": "link:../../fams-design-system/packages/v5-kit",
    "@fams/v5-templates": "link:../../fams-design-system/packages/v5-templates",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "msw": "^2.15.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@visual-regression-tracker/agent-playwright": "^5.3.1",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

    {
      "col": "systemcol3",
      "component": {
        "name": "IconTextView",
        "props": {
          "icon": "tag"
        }
      },
      "id": "fld_lead_source",
      "listValues": [
        "Website",
        "Referral",
        "Cold Call",
        "Trade Show",
        "Social Media"
      ],
      "name": "Source",
      "type": "SingleSelect"
    },
    {
      "col": "systemcol4",
      "component": {
        "name": "IconSelect",
        "props": {
          "icon": "flag",
          "optionTone": {
            "CRITICAL": "error",
            "HIGH": "warning",
            "LOW": "info",
            "MEDIUM": "success"
          }
        }
      },
      "default": "MEDIUM",
      "id": "fld_lead_priority",
      "listValues": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "name": "Priority",
      "type": "SingleSelect"
    },
    {
      "col": "systemcol5",
      "id": "fld_lead_value",
      "name": "Estimated Value",
      "type": "Numeric",
      "unit": "USD"
    },
    {
      "col": "systemcol6",
      "creation": {
        "hidden": true
      },
      "id": "fld_lead_created",
      "name": "Created Date",
      "type": "Date"
    },
    {
      "col": "systemcol7",
      "id": "fld_lead_due",
      "name": "Follow-up Due",
      "type": "Date"
    },
    {
      "col": "systemcol8",
      "component": {
        "name": "LinkView"
      },
      "creation": {
        "hidden": true
      },
      "entityType": "crm/deal",

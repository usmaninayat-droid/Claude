      "name": "Converts To Deal",
      "refModule": "Entity",
      "type": "SingleReference"
    },
    {
      "col": "systemcol9",
      "id": "fld_lead_note",
      "name": "Note",
      "type": "BigText"
    },
    {
      "col": "status",
      "creation": {
        "hidden": true
      },
      "default": "new",
      "id": "fld_lead_status",
      "listValues": [
        "new",
        "contacted",
        "qualified",
        "unqualified",
        "converted"
      ],
      "name": "Status",
      "type": "SingleSelect"
    },
    {
      "col": "tags",
      "id": "fld_lead_tags",
      "name": "Tags",
      "type": "tags"
    }
